{
  "name": "prism",
  "private": true,
  "version": "0.1.0",
  "description": "PRISM — GitHub Pull Request Analyzer",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c teal,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev -w @prism/web",
    "build": "npm run build -w @prism/web",
    "lint": "npm run lint -w @prism/web",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,json,md}\"",
    "test:api": "cd apps/api && python -m pytest -q",
    "typecheck": "npm run typecheck -w @prism/web && npm run typecheck -w @prism/shared"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "prettier": "^3.5.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
